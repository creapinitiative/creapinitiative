# Copy this file to .env and fill in real values for local development.
# In production (Cloudflare Pages), set these same names under
# Settings -> Environment Variables instead of using this file.

# Supabase project settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# GitHub fine-grained PAT with Contents: read and write on this repo only
GITHUB_TOKEN=
GITHUB_OWNER=kingsmac1
GITHUB_REPO=creapinitiative-website-redesign

# Paystack (Dashboard -> Settings -> API Keys & Webhooks). Use the sk_live_… key in production.
PAYSTACK_SECRET_KEY=
